{
  "name": "@sentinel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=../../dist/server.js --external:better-sqlite3 --external:argon2 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "true",
    "verify-audit": "tsx ../../packages/db/src/cli/verify-audit.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@sentinel/db": "workspace:*",
    "@sentinel/shared": "workspace:*",
    "@sentinel/stats": "workspace:*",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.12.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
